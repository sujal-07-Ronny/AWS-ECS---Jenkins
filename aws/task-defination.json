{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "LearnJenkinsApp",
    "containerDefinitions": [
        {
            "name": "learnjenkinsapp",
            "image": "ronny710/jenkins-ecs:latest",
            "portMappings": [
                {   
                    "name": "nginx-80-tip",
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "512 MiB",
    "cpu": "256",
    "executionRoleArn": "arn:aws:iam::435204303108:role/ecsTaskExecutionRole"
}